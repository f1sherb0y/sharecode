# Server config
PORT=3001
DATABASE_URL=postgresql://sharecode:sharecode@localhost:5432/sharecode
JWT_SECRET=dev-jwt-secret-change-this-in-production-please
LOG_LEVEL=info
ALLOW_REGISTRATION=true

# Share link base URL (prefer FRONTEND_URL; APP_URL is fallback)
FRONTEND_URL=http://localhost:5173
APP_URL=
FRONTEND_HASH_ROUTER=false

# Code execution (Piston)
PISTON_URL=http://localhost:2000

# Admin bootstrap (created on startup if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@sharecode.local
ADMIN_UPDATE_PASSWORD=false
