# ShareCode Frontend Environment Configuration
# Copy this file to `.env` and adjust as needed.
#
# For PRODUCTION builds, these are baked in at build time via Docker build args.

# ===========================
# API Configuration
# ===========================
# Development: point to local server
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/api/ws

# Production: leave empty to use same-origin (relative URLs)
# The frontend will use /api/* which Caddy proxies to the server
# VITE_API_URL=
# VITE_WS_URL=

# ===========================
# Feature Flags
# ===========================
# Toggle user registration UI (set to "false" to hide the register form)
VITE_ALLOW_REGISTRATION=true
