# ShareCode Production Environment Configuration
# Copy this file to .env and update with your actual values

# ===========================
# Domain Configuration
# ===========================
# Your domain name (e.g., sharecode.example.com)
# For local development, use "localhost"
DOMAIN=your-domain.com

# Frontend URL for CORS (should match DOMAIN with https://)
FRONTEND_URL=https://your-domain.com

# ===========================
# Database Configuration
# ===========================
# Secure password for PostgreSQL
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=your-secure-postgres-password-here

# ===========================
# Security Configuration
# ===========================
# JWT Secret for authentication tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-here

# ===========================
# Admin Account
# ===========================
# Default admin credentials (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-here
ADMIN_EMAIL=admin@your-domain.com

# ===========================
# Application Configuration
# ===========================
# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Registration Control
# Set to 'false' to disable new user registration
ALLOW_REGISTRATION=false

# ===========================
# Judge0 Code Execution
# ===========================
# Secret key for Judge0 Rails application
# Generate with: openssl rand -base64 32
JUDGE0_SECRET_KEY=your-judge0-secret-key-here

# Password for Judge0's PostgreSQL database
# Generate with: openssl rand -base64 32
JUDGE0_DB_PASSWORD=your-judge0-db-password-here

# Optional: Authentication token for Judge0 API
# If set, all requests to Judge0 must include this token
# Generate with: openssl rand -base64 32
JUDGE0_AUTH_TOKEN=

# ===========================
# Notes
# ===========================
# 1. Never commit .env file to git
# 2. Use strong, unique passwords for production
# 3. Generate random secrets with: openssl rand -base64 32
# 4. Update DOMAIN to your actual domain name
# 5. Caddy will automatically obtain SSL certificates for your domain
