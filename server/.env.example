# ShareCode Server Environment Configuration
# Copy this file to `.env` and adjust as needed.
#
# For PRODUCTION, use the root .env.example instead (docker-compose will use it)

# ===========================
# Database
# ===========================
# Development: localhost
DATABASE_URL="postgresql://sharecode:sharecode_dev_password@localhost:5432/sharecode?schema=public"
# Production (Docker): postgresql://sharecode_app:${POSTGRES_PASSWORD}@postgres:5432/sharecode?schema=public

# ===========================
# Security
# ===========================
# JWT Secret - CHANGE IN PRODUCTION
# Generate with: openssl rand -base64 32
JWT_SECRET="dev-jwt-secret-change-this-in-production-please"

# ===========================
# Server
# ===========================
PORT=3000

# Frontend URL (for CORS)
# Development:
FRONTEND_URL="http://localhost:5173"
# Production: https://your-domain.com

# ===========================
# Logging
# ===========================
# Options: debug, info, warn, error
LOG_LEVEL="debug"

# ===========================
# Registration Control
# ===========================
# Set to 'false' to disable new user registration
ALLOW_REGISTRATION="true"

# ===========================
# Admin Account
# ===========================
# Default admin credentials - CHANGE THESE IN PRODUCTION!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
ADMIN_EMAIL="admin@sharecode.local"
# Set to 'true' to update admin password on restart
# ADMIN_UPDATE_PASSWORD="false"

# ===========================
# Code Execution (Judge0)
# ===========================
# Development: localhost
JUDGE0_URL="http://localhost:2358"
# Production (Docker): http://judge0-server:2358

# Optional: Authentication token for Judge0 API
JUDGE0_AUTH_TOKEN=""
